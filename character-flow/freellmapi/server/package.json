{
  "name": "@freellmapi/server",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "bin": {
    "sword-cli": "bin/sword-cli.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "agent": "node bin/sword-cli.mjs",
    "test": "vitest run --pool=forks --fileParallelism=false",
    "test:watch": "vitest",
    "export-catalog": "tsx src/scripts/export-catalog.ts",
    "sword": "node bin/sword-cli.mjs"
  },
  "dependencies": {
    "@freellmapi/shared": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
