{
  "name": "swordcli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sword": "./bin/sword"
  },
  "scripts": {
    "sword": "node bin/sword --shared",
    "sword:local": "node bin/sword --local",
    "dev:web": "node character-flow/character-flow/character-flow/server.js",
    "dev:freellmapi": "cd character-flow/character-flow/freellmapi/server && npm run dev",
    "dev": "npm run dev:freellmapi & sleep 2 && npm run dev:web",
    "build:web": "cd character-flow/character-flow/web && npm run build",
    "setup": "npm install && cd character-flow/character-flow && npm install && cd freellmapi/server && npm install"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chalk": "^5.3.0",
    "g4f": "^1.0.0",
    "ora": "^8.0.0"
  }
}
